<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mediconnect.controller.DashboardController"
            prefHeight="700"
            prefWidth="1200"
            stylesheets="@../css/dashboard.css"
            style="-fx-background-color:#F1F5F9;">

    <!-- Sidebar -->

    <AnchorPane prefWidth="220"
                prefHeight="700"
                style="-fx-background-color:linear-gradient(to bottom,#2563EB,#06B6D4);">

        <Label layoutX="20"
               layoutY="30"
               text="MEDICONNECT"
               style="-fx-text-fill:white;
                      -fx-font-size:22px;
                      -fx-font-weight:bold;"/>

        <VBox layoutX="20"
              layoutY="90"
              spacing="15">

          <Button text="🏠 Dashboard"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openDashboard"/>

<Button text="💳 Billing"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openBilling"/>

<Button text="💊 Medicines"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openMedicines"/>

<Button text="📦 Inventory"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openInventory"/>

<Button text="⏰ Expiry"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openExpiry"/>

<Button text="📊 Reports"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openReports"/>

<Button text="🧑 Patients"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openPatients"/>

<Button text="⚙ Settings"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openSettings"/>

<Button text="🚪 Logout"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#logout"/>


        </VBox>

    </AnchorPane>

    <!-- Header -->

    <AnchorPane layoutX="220"
                prefHeight="70"
                prefWidth="980"
                style="-fx-background-color:white;">

        <Label layoutX="30"
               layoutY="20"
               text="Dashboard"
               style="-fx-font-size:26px;
                      -fx-font-weight:bold;"/>

        <Label layoutX="820"
               layoutY="25"
               text="Welcome Admin"/>
    </AnchorPane>

    <!-- Cards -->

    <AnchorPane layoutX="250"
                layoutY="100"
                prefHeight="120"
                prefWidth="200"
                styleClass="dashboard-card">

        <Label layoutX="20"
               layoutY="20"
               text="Today's Sales"/>

        <Label layoutX="20"
               layoutY="60"
               text="₹15,000"
               style="-fx-font-size:28px;
                      -fx-font-weight:bold;"/>
    </AnchorPane>

    <AnchorPane layoutX="480"
                layoutY="100"
                prefHeight="120"
                prefWidth="200"
                styleClass="dashboard-card">

        <Label layoutX="20"
               layoutY="20"
               text="Today's Bills"/>

        <Label layoutX="20"
               layoutY="60"
               text="320"
               style="-fx-font-size:28px;
                      -fx-font-weight:bold;"/>
    </AnchorPane>

    <AnchorPane layoutX="710"
                layoutY="100"
                prefHeight="120"
                prefWidth="200"
                styleClass="dashboard-card">

        <Label layoutX="20"
               layoutY="20"
               text="Expiring Soon"/>

        <Label layoutX="20"
               layoutY="60"
               text="12"
               style="-fx-font-size:28px;
                      -fx-font-weight:bold;"/>
    </AnchorPane>

    <AnchorPane layoutX="940"
                layoutY="100"
                prefHeight="120"
                prefWidth="200"
                styleClass="dashboard-card">

        <Label layoutX="20"
               layoutY="20"
               text="Low Stock"/>

        <Label layoutX="20"
               layoutY="60"
               text="18"
               style="-fx-font-size:28px;
                      -fx-font-weight:bold;"/>
    </AnchorPane>

</AnchorPane>