<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mediconnect.controller.InventoryController"
            prefHeight="900"
            prefWidth="1400"
            stylesheets="@../css/dashboard.css"
            style="-fx-background-color:#F1F5F9;">

    <!-- Sidebar -->

    <AnchorPane prefWidth="220"
                prefHeight="900"
                style="-fx-background-color:linear-gradient(to bottom,#2563EB,#06B6D4);">

        <Label layoutX="20"
               layoutY="30"
               text="MEDICONNECT"
               style="-fx-text-fill:white;
                      -fx-font-size:22px;
                      -fx-font-weight:bold;"/>

        <VBox layoutX="20"
              layoutY="90"
              spacing="15">

        <Button text="🏠 Dashboard"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openDashboard"/>

        <Button text="💳 Billing"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openBilling"/>

        <Button text="💊 Medicines"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openMedicines"/>

        <Button text="📦 Inventory"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openInventory"/>

        <Button text="⏰ Expiry"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openExpiry"/>

        <Button text="📊 Reports"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openReports"/>

        <Button text="🧑 Patients"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openPatients"/>

        <Button text="⚙ Settings"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openSettings"/>

        <Button text="🚪 Logout"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#logout"/>

        </VBox>

    </AnchorPane>

    <!-- Header -->

    <AnchorPane layoutX="220"
                layoutY="0"
                prefHeight="80"
                prefWidth="1180"
                style="-fx-background-color:white;">

        <Label layoutX="30"
               layoutY="25"
               text="Inventory Management"
               style="-fx-font-size:28px;
                      -fx-font-weight:bold;"/>

    </AnchorPane>

    <!-- Search -->

    <Label layoutX="260"
           layoutY="120"
           text="Search Medicine"
           style="-fx-font-size:16px;
                  -fx-font-weight:bold;"/>

    <TextField fx:id="txtSearch"
               layoutX="420"
               layoutY="115"
               prefHeight="35"
               prefWidth="350"
               promptText="Enter Medicine Name"/>

    <Button fx:id="btnSearch"
        layoutX="800"
        layoutY="115"
        prefHeight="35"
        prefWidth="120"
        text="SEARCH"
        onAction="#searchMedicine"/>

    <!-- Inventory Table -->

    <TableView fx:id="inventoryTable"
               layoutX="250"
               layoutY="180"
               prefHeight="500"
               prefWidth="1120">

        <columns>

            <TableColumn fx:id="colId"
                         text="ID"
                         prefWidth="60"/>

            <TableColumn fx:id="colMedicineName"
                         text="Medicine Name"
                         prefWidth="220"/>

            <TableColumn fx:id="colCompany"
                         text="Company"
                         prefWidth="180"/>

            <TableColumn fx:id="colCategory"
                         text="Category"
                         prefWidth="120"/>

            <TableColumn fx:id="colBatchNo"
                         text="Batch No"
                         prefWidth="120"/>

            <TableColumn fx:id="colExpiryDate"
                         text="Expiry Date"
                         prefWidth="120"/>

            <TableColumn fx:id="colPrice"
                         text="Price"
                         prefWidth="100"/>

            <TableColumn fx:id="colQuantity"
                         text="Quantity"
                         prefWidth="100"/>

            <TableColumn fx:id="colGST"
                         text="GST"
                         prefWidth="80"/>

        </columns>

    </TableView>

    <!-- Bottom Buttons -->

    <Button fx:id="btnRefresh"
        layoutX="320"
        layoutY="740"
        prefHeight="40"
        prefWidth="150"
        text="REFRESH"
        onAction="#refreshInventory"/>

    <Button fx:id="btnLowStock"
        layoutX="520"
        layoutY="740"
        prefHeight="40"
        prefWidth="180"
        text="LOW STOCK"
        onAction="#showLowStock"/>

    <Button fx:id="btnExpired"
        layoutX="750"
        layoutY="740"
        prefHeight="40"
        prefWidth="180"
        text="EXPIRING SOON"
        onAction="#showExpiringSoon"/>

</AnchorPane>