<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mediconnect.controller.ExpiryController"
            prefHeight="700.0"
            prefWidth="1200.0"
            style="-fx-background-color: linear-gradient(to bottom right,#DBEAFE,#BFDBFE,#93C5FD);"
            stylesheets="@dashboard.css">

    <!-- Sidebar -->

    
    <AnchorPane prefWidth="220"
                prefHeight="900"
                style="-fx-background-color:linear-gradient(to bottom,#2563EB,#06B6D4);">

        <Label layoutX="20"
               layoutY="30"
               text="MEDICONNECT"
               style="-fx-text-fill:white;
                      -fx-font-size:22px;
                      -fx-font-weight:bold;"/>

        <VBox layoutX="20"
              layoutY="90"
              spacing="15">

        <Button text="🏠 Dashboard"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openDashboard"/>

        <Button text="💳 Billing"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openBilling"/>

        <Button text="💊 Medicines"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openMedicines"/>

        <Button text="📦 Inventory"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openInventory"/>

        <Button text="⏰ Expiry"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openExpiry"/>

        <Button text="📊 Reports"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openReports"/>

        <Button text="🧑 Patients"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openPatients"/>

        <Button text="⚙ Settings"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#openSettings"/>

        <Button text="🚪 Logout"
        styleClass="menu-item"
        prefWidth="180"
        onAction="#logout"/>

        </VBox>


    </AnchorPane>

    <!-- Header -->

    <AnchorPane layoutX="220"
                layoutY="0"
                prefHeight="70"
                prefWidth="980"
                style="-fx-background-color:white;">

        <Label layoutX="30"
               layoutY="18"
               text="Expiry Management"
               style="-fx-font-size:32px;
                      -fx-font-weight:bold;
                      -fx-text-fill:#1E293B;"/>

    </AnchorPane>

    <!-- Warning -->

    <AnchorPane layoutX="260"
                layoutY="100"
                prefHeight="55"
                prefWidth="880"
                style="-fx-background-color:#FEE2E2;
                       -fx-background-radius:15;">

        <Label layoutX="20"
               layoutY="14"
               text="⚠ Medicines expiring within next 30 days."
               style="-fx-font-size:20px;
                      -fx-font-weight:bold;
                      -fx-text-fill:#991B1B;"/>

    </AnchorPane>

    <!-- Table -->

    <TableView fx:id="expiryTable"
               layoutX="260"
               layoutY="190"
               prefHeight="450"
               prefWidth="880">

        <columns>

            <TableColumn fx:id="colId"
                         text="ID"
                         prefWidth="60"/>

            <TableColumn fx:id="colMedicineName"
                         text="Medicine Name"
                         prefWidth="260"/>

            <TableColumn fx:id="colBatchNo"
                         text="Batch No"
                         prefWidth="180"/>

            <TableColumn fx:id="colExpiryDate"
                         text="Expiry Date"
                         prefWidth="180"/>

            <TableColumn text="Days Left"
                         prefWidth="180"/>

        </columns>

    </TableView>

</AnchorPane>